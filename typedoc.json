{
  "entryPoints": ["src/index.ts", "src/file.ts", "src/mmap.ts", "src/polyfills.ts"], // Adjust to your main TypeScript file(s)
  "plugin": [
    // https://github.com/Gerrit0/typedoc-plugin-coverage
    "typedoc-plugin-coverage",
    // https://gitlab.com/stranskyjan/typedoc-plugin-katex
    "typedoc-plugin-katex"
  ],
  "out": "docs",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "excludeNotDocumented": true,
  "hideGenerator": true,
  "disableSources": true,
  "coverageOutputPath": "assets/doc-coverage.svg",
  "highlightLanguages": [
    "typescript",
    "csv",
    "rust",
    "json",
    "toml",
    "bash",
    "html",
    "css",
    "markdown",
    "yaml",
    "ini"
  ],
  "katex": {
    "delimiters": [
      { "left": "$$", "right": "$$", "display": true },
      { "left": "$", "right": "$", "display": false }
    ]
    // You can also configure other KaTeX options here if needed
  }
}
