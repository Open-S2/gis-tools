{
  "typescript.tsdk": "node_modules/typescript/lib",
  "eslint.useFlatConfig": true,
  // "files.exclude": {
  //     "rust/proj/generated": true,
  //     "rust/proj/generated/epsg.rs": true
  // },
  "rust-analyzer.files.exclude": ["rust/proj/generated/", "rust/proj/generated/epsg.rs"],
  "rust-analyzer.files.watcherExclude": ["rust/proj/generated/"],
  "rust-analyzer.exclude": ["rust/proj/generated/", "rust/proj/generated/epsg.rs"],
  "rust-analyzer.excludeGlobs": ["rust/proj/generated/**"],
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "rust/proj/generated/**": true
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
